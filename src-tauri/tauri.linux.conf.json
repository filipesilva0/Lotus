      "deb": {
        "files": {
          "/usr/share/lotus/lotusd": "binaries/lotusd-x86_64-unknown-linux-gnu"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/lotus/lotusd": "binaries/lotusd-x86_64-unknown-linux-gnu"
        }
      }
    }
