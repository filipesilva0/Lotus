        "title": "Lotus",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "shadow": true,
        "transparent": false,
        "visible": false
      },
      {
        "label": "island",
        "dragDropEnabled": false,
        "title": "Lotus Island",
        "url": "island.html",
        "width": 420,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ]
  },
