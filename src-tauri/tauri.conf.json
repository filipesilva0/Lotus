{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomo",
  "version": "0.1.0",
  "identifier": "app.tomo.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tomo",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      },
      {
        "label": "island",
        "title": "Tomo Island",
        "url": "island.html",
        "width": 420,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "publisher": "Tomo",
    "shortDescription": "A local AI studio: chat, images and voice on your own machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "template": "wix/main.wxs",
        "language": "en-US",
        "upgradeCode": "6f4a7c52-3b1e-4f0a-9d8c-2a5e7b91c4d3"
      }
    },
    "licenseFile": "wix/license.rtf"
  }
}